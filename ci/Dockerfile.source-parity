# Experimental comparison image only, NOT a production-ready independent base.
# Preserve the official image's OS, Python packages, wkhtmltopdf, entrypoint
# and binary tools while replacing Odoo's Python/addon source in full.
ARG REFERENCE_RUNTIME=odoo:20.0-20261015@sha256:3de556969ca7916fe7d1a7fa3be2a49307a147c5fa1491bc2c57dcb0b950bea5
FROM ${REFERENCE_RUNTIME}

USER root
RUN rm -rf /usr/lib/python3/dist-packages/odoo
COPY --chown=odoo:odoo odoo/ /usr/lib/python3/dist-packages/odoo/
COPY --chown=odoo:odoo addons/ /usr/lib/python3/dist-packages/odoo/addons/
USER odoo
ENTRYPOINT ["/entrypoint.sh"]
CMD ["odoo"]
